{
  "name": "@tsms/config",
  "version": "0.0.0",
  "private": true,
  "license": "UNLICENSED",
  "type": "module",
  "main": "./dist/env.js",
  "types": "./dist/env.d.ts",
  "exports": {
    ".": {
