// TSMS database schema.
//
// Stage 2.1: global identity persistence only. Authentication behavior, school
// membership (Stage 3), and authorization (Stage 4) are separate future tasks.
// UUIDv7 defaults are generated by Prisma; direct SQL writers must supply IDs.
// Dates retain the Stage 1 DateTime / PostgreSQL TIMESTAMP(3) convention (UTC).

generator client {
  provider               = "prisma-client"
  // Prisma 7 generates plain TypeScript into the package instead of into
  // node_modules, so this package compiles it with its own tsc build and the
  // emitted JavaScript is what applications import.
  output                 = "../src/generated/prisma"
  // `importFileExtension = "js"` keeps generated imports in the `./file.js`
  // form that NodeNext both understands and can resolve at runtime. The `ts`
  // form is only for running generated TypeScript directly under tsx, which
  // this repository does not do.
  runtime                = "nodejs"
  moduleFormat           = "esm"
  generatedFileExtension = "ts"
  importFileExtension    = "js"
}

datasource db {
  provider = "postgresql"
}

/// Infrastructure connectivity probe.
///
/// This is deliberately NOT a business concept. It exists so that Stage 1 can
/// prove end to end that migrations are applied, the generated client can read
/// and write through the typed query layer, and integration tests can verify a
/// real query round trip. It carries no tenant, school, or student meaning.
///
/// Retained in Stage 2.1 to preserve the independent infrastructure regression
/// tests. Remove only through a future forward migration with replacement tests.
model InfrastructureProbe {
  id        Int      @id @default(autoincrement())
  label     String   @unique
  createdAt DateTime @default(now())

  @@map("infrastructure_probes")
}

enum UserStatus {
  ACTIVE
  DISABLED
}

enum AuthenticationEventType {
  LOGIN_SUCCEEDED
  LOGIN_FAILED
  LOGOUT
  SESSION_REVOKED
  PASSWORD_CHANGED
  PASSWORD_RESET_REQUESTED
  PASSWORD_RESET_COMPLETED
  ACCOUNT_DISABLED
  EMAIL_VERIFIED
}

/// Global identity, independent of school membership and permissions.
model User {
  id              String     @id @default(uuid(7)) @db.Uuid
  email           String
  /// Future writers must trim surrounding whitespace and lowercase only.
  /// No provider-specific dot removal or plus-address stripping.
  normalizedEmail String     @unique
  displayName     String
  status          UserStatus @default(ACTIVE)
  emailVerifiedAt DateTime?
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  passwordCredential      PasswordCredential?
  sessions                Session[]
  passwordResetTokens     PasswordResetToken[]
  emailVerificationTokens EmailVerificationToken[]
  authenticationEvents    AuthenticationEvent[]

  @@map("users")
}

/// Hash persistence only; no password hashing or verification behavior yet.
model PasswordCredential {
  id                String   @id @default(uuid(7)) @db.Uuid
  userId            String   @unique @db.Uuid
  passwordHash      String
  passwordChangedAt DateTime @default(now())
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  user              User     @relation(fields: [userId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@map("password_credentials")
}

/// Store a digest only, never the raw bearer token. No session behavior yet.
model Session {
  id         String    @id @default(uuid(7)) @db.Uuid
  userId     String    @db.Uuid
  tokenHash  String    @unique
  createdAt  DateTime  @default(now())
  expiresAt  DateTime
  lastSeenAt DateTime?
  revokedAt  DateTime?
  user       User      @relation(fields: [userId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@index([userId])
  @@index([expiresAt])
  @@map("sessions")
}

/// Hash-only recovery persistence; usedAt represents consumption, not enforcement.
model PasswordResetToken {
  id        String    @id @default(uuid(7)) @db.Uuid
  userId    String    @db.Uuid
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@index([userId])
  @@index([expiresAt])
  @@map("password_reset_tokens")
}

/// Hash-only verification persistence; delivery and consumption are future work.
model EmailVerificationToken {
  id        String    @id @default(uuid(7)) @db.Uuid
  userId    String    @db.Uuid
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@index([userId])
  @@index([expiresAt])
  @@map("email_verification_tokens")
}

/// Nullable identity supports events before a user is known. Restrict preserves
/// known-user attribution on deletion. No arbitrary metadata/request dump column;
/// any future metadata needs an explicit sanitized, bounded contract.
model AuthenticationEvent {
  id         String                  @id @default(uuid(7)) @db.Uuid
  userId     String?                 @db.Uuid
  eventType  AuthenticationEventType
  occurredAt DateTime                @default(now())
  /// Correlation identifier only; never headers, tokens, or request bodies.
  requestId  String?
  user       User?                   @relation(fields: [userId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@index([userId, occurredAt])
  @@map("authentication_events")
}
