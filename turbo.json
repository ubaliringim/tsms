{
  "$schema": "https://turborepo.dev/schema.json",
  "globalDependencies": ["tsconfig.json"],
  "globalEnv": [
    "NODE_ENV",
    "API_HOST",
    "API_PORT",
    "WORKER_HOST",
    "WORKER_HEALTH_PORT",
    "DATABASE_URL",
    "REDIS_URL",
    "API_TRUSTED_ORIGINS",
    "API_PASSWORD_RECOVERY_DELIVERY_MODE",
    "API_PASSWORD_RECOVERY_URL_BASE",
    "API_RATE_LIMIT_HMAC_SECRET",
    "TSMS_API_ORIGIN",
    "E2E_REDIS_DB"
  ],
  "tasks": {
    "db:generate": {
      "cache": false
    },
    "build": {
      "dependsOn": ["^build", "db:generate"],
      "outputs": ["dist/**", ".next/**", "!.next/cache/**"]
    },
    "typecheck": {
      "dependsOn": ["^build", "db:generate"],
      "outputs": []
    },
    "test": {
      "dependsOn": ["build"],
      "outputs": []
    },
    "test:integration": {
      "dependsOn": ["build"],
      "env": ["TEST_DATABASE_URL", "TEST_REDIS_URL"],
      "outputs": [],
      "cache": false
    },
    "@tsms/web#test:integration": {
      "dependsOn": ["build", "@tsms/api#test:integration"],
      "env": ["TEST_DATABASE_URL", "TEST_REDIS_URL"],
      "outputs": [],
      "cache": false
    },
    "@tsms/web#test:e2e": {
      "dependsOn": ["build"],
      "env": ["TEST_DATABASE_URL", "TEST_REDIS_URL", "E2E_REDIS_DB", "E2E_BROWSER_CHANNEL"],
      "outputs": [],
      "cache": false
    },
    "dev": {
      "dependsOn": ["^build"],
      "cache": false,
      "persistent": true
    }
  }
}
