# Safe local examples only. No real credentials belong in this file.
# Copy to .env for local development: every value below is a throwaway that only
# works against the Docker Compose services in infrastructure/docker-compose.yml.
# API/worker commands and the Prisma CLI load the repository .env when present.

NODE_ENV=development
API_HOST=127.0.0.1
API_PORT=4000
WORKER_HOST=127.0.0.1
WORKER_HEALTH_PORT=4001

# Web: 3000; Control: 3001 (set by their package scripts).

# --- Browser origins allowed to call the API ---------------------------------
# Required by the API in every environment (Stage 2.4). Comma-separated absolute
# origins, compared exactly - scheme, host, and port - against the Origin header of
# POST /auth/login and POST /auth/logout. There is no wildcard and no fallback to
# Host or X-Forwarded-Host, so this list is the only source of trusted origins.
# The values below are the loopback development origins for web (3000) and control
# (3001). Production must list its real HTTPS origins and nothing else.
API_TRUSTED_ORIGINS=http://127.0.0.1:3000,http://127.0.0.1:3001

# --- Infrastructure endpoints (required by the API and the worker) -----------
# The user/password pairs below match infrastructure/docker-compose.yml and are
# development-only. Replace them with injected secrets in staging and production.
DATABASE_URL=postgresql://tsms:tsms_local_development@127.0.0.1:5432/tsms
REDIS_URL=redis://:tsms_local_redis@127.0.0.1:6379

# --- Integration tests only ---------------------------------------------------
# Used exclusively by `pnpm test:integration`. Integration tests refuse to run
# unless the database name ends in _test and the Redis URL selects a non-zero
# logical database, so these cannot point at the application data above.
TEST_DATABASE_URL=postgresql://tsms:tsms_local_development@127.0.0.1:5432/tsms_test
TEST_REDIS_URL=redis://:tsms_local_redis@127.0.0.1:6379/1

# Do not add private values with NEXT_PUBLIC_ or EXPO_PUBLIC_ prefixes.