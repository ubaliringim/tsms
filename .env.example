# Safe local examples only. No real credentials belong in this file.
# Copy to .env for local development: every value below is a throwaway that only
# works against the Docker Compose services in infrastructure/docker-compose.yml.
# API/worker commands and the Prisma CLI load the repository .env when present.

NODE_ENV=development
API_HOST=127.0.0.1
API_PORT=4000
WORKER_HOST=127.0.0.1
WORKER_HEALTH_PORT=4001

# Web: 3000; Control: 3001 (set by their package scripts).

# --- Browser origins allowed to call the API ---------------------------------
# Required by the API in every environment (Stage 2.4). Comma-separated absolute
# origins, compared exactly - scheme, host, and port - against the Origin header of
# POST /auth/login and POST /auth/logout. There is no wildcard and no fallback to
# Host or X-Forwarded-Host, so this list is the only source of trusted origins.
# The values below are the loopback development origins for web (3000) and control
# (3001). Production must list its real HTTPS origins and nothing else.
API_TRUSTED_ORIGINS=http://127.0.0.1:3000,http://127.0.0.1:3001

# --- Infrastructure endpoints (required by the API and the worker) -----------
# The user/password pairs below match infrastructure/docker-compose.yml and are
# development-only. Replace them with injected secrets in staging and production.
DATABASE_URL=postgresql://tsms:tsms_local_development@127.0.0.1:5432/tsms
REDIS_URL=redis://:tsms_local_redis@127.0.0.1:6379

# --- Integration tests only ---------------------------------------------------
# Used exclusively by `pnpm test:integration`. Integration tests refuse to run
# unless the database name ends in _test and the Redis URL selects a non-zero
# logical database, so these cannot point at the application data above.
TEST_DATABASE_URL=postgresql://tsms:tsms_local_development@127.0.0.1:5432/tsms_test
TEST_REDIS_URL=redis://:tsms_local_redis@127.0.0.1:6379/1

# Do not add private values with NEXT_PUBLIC_ or EXPO_PUBLIC_ prefixes.
# --- Password recovery (Stage 2.5) -------------------------------------------------
# NO real email provider is authorized yet, so delivery defaults to `disabled` and
# both recovery endpoints fail closed with 503. Nothing is emailed and no token is
# created until a real delivery adapter is added under separate authorization.
API_PASSWORD_RECOVERY_DELIVERY_MODE=disabled
# Required only when delivery is enabled. Absolute HTTPS origin of the page that
# redeems a recovery token; the reset link is built from this value and never from
# a Host or X-Forwarded-* header. Must contain no credentials, query, or fragment.
# API_PASSWORD_RECOVERY_URL_BASE=https://app.example.com/account/recover

# --- Rate limiting (Stage 2.6) -------------------------------------------------
# Required by the API in every environment. Authentication endpoints are protected by Redis-backed
# distributed meters, and every subject is reduced to a domain-separated HMAC-SHA256 before it becomes
# a Redis key, so no raw email address, recovery token, or session token is ever stored as key
# material. This secret is that HMAC key: it never authorises a request, is never sent to a client,
# and is not authentication material. Startup fails if it is absent, shorter than 32 characters,
# longer than 512, contains a character outside [A-Za-z0-9_-], or is a known placeholder.
#
# EVERY API INSTANCE MUST SHARE THIS VALUE. A per-instance secret produces disjoint key spaces, which
# would silently turn a distributed limit into one limit per instance. Production must supply an
# injected random secret, unique per deployment.
API_RATE_LIMIT_HMAC_SECRET=tsms_local_development_rate_limit_key_replace_in_production

# --- Web authentication proxy (Stage 2.8) ---------------------------------------
# The web app (apps/web) is the only origin a browser talks to. Its /api/auth/{login,me,logout} routes relay
# to the API server-side, so the session cookie belongs to the web origin and the API needs no CORS.
# Read by the WEB SERVER only (never NEXT_PUBLIC_, never sent to a browser). Absolute origin: scheme, host
# and optional port, with no credentials, path, query, or fragment.
#   - development: optional; defaults to http://127.0.0.1:4000
#   - production: REQUIRED. Missing or malformed fails closed with 503 - there is no development fallback.
#     Must be https, except for a loopback address (for example a local production-mode run).
# Next.js reads environment variables from apps/web/.env* or the process environment, not this root file;
# export it for `pnpm --filter @tsms/web start`.
# The web origin that browsers use (http://127.0.0.1:3000 in development) must be listed in
# API_TRUSTED_ORIGINS above: the API still checks the browser's own Origin, which the proxy forwards verbatim.
# TSMS_API_ORIGIN=http://127.0.0.1:4000
# --- Browser suite (Stage 2.8) --------------------------------------------------
# `pnpm test:e2e` runs a real browser against a production build. It uses its OWN Redis logical database so it
# can reset the rate limiter without touching the state the integration suites use. Optional; must be a
# non-zero database different from the one in TEST_REDIS_URL. Not read by the API or the web server.
# E2E_REDIS_DB=2
# Use an installed Google Chrome instead of Playwright's bundled Chromium (for a machine that cannot download it).
# E2E_BROWSER_CHANNEL=chrome
