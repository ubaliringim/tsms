# Safe local examples only; no credentials are required in Stage 0.
# API/worker commands load the root .env when present.
NODE_ENV=development
API_HOST=127.0.0.1
API_PORT=4000
WORKER_HOST=127.0.0.1
WORKER_HEALTH_PORT=4001
# Web: 3000; Control: 3001 (set by their package scripts).
# Do not add private values with NEXT_PUBLIC_ or EXPO_PUBLIC_ prefixes.
