  "dependencies": {
    "@tsms/config": "workspace:*",
    "@tsms/database": "workspace:*",
    "@tsms/redis": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "24.10.1",
    "typescript": "6.0.3",
    "tsx": "4.23.15",
    "vitest": "5.0.3"
  }
}
